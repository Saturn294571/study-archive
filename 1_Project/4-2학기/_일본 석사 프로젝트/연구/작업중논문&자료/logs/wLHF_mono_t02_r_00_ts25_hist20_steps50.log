import numpy as np

# Parameters
a = 10.0
b = 0.1
tau = 0.2
w = 1.0
K0 = 1.0
rho = 0.0
A0 = 1.0

# Define LABOR range
LABOR_range = np.arange(0, 101, 10)

# Initialize table with profit values
profit_table = []

for L in LABOR_range:
    # Calculate Q and P
    A = A0 * (1 + rho)
    Q = A * K0**0.33 * L**0.6699999999999999
    P = a - b*Q

    # Calculate profit
    pi = P*Q - w*L - tau*Q

    # Append to table
    profit_table.append((L, pi))

# Find LABOR value that maximizes profit
